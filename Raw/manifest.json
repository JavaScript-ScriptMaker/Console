{
  "manifest_version": 3,
  "name": "Expandable Console",
  "version": "1.0",
  "description": "Modular injection console with autocomplete, CSP bypass, and native favicon injection.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "Popup.html"
  }
}
